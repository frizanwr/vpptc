# File startup
# ---------------------------------------------------------------------------
def write_startup_file(path, commands, source_config):
    """Tulis file CLI startup secara atomik (BUG MINOR: file tidak terpotong).

    Catatan penting soal komentar: parser CLI VPP TIDAK mengenal '//'. Satu baris
    komentar '//' memicu "CLI line error" yang membatalkan seluruh sisa file, jadi
    seluruh policer gagal dimuat. Karakter komentar yang benar adalah '#'.
    """
    header = [
        "# AUTO-GENERATED by vpptc - DO NOT EDIT MANUALLY",
        f"# Regenerate with: vpptc --config {source_config}",
    ]
    body = "\n".join(header + commands)
    if commands:
        body += "\n"

    # Penjaga: parser CLI VPP hanya mengenal '#'. Bila suatu baris tidak dikenal,
    # VPP membatalkan seluruh file - semua policer gagal dimuat tanpa jejak.
    for number, line in enumerate(body.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith("#"):
            continue
        if "//" in stripped:
            print(f"[ERROR] Baris {number} memuat '//' yang ditolak parser CLI VPP "
                  f"dan akan membatalkan seluruh file startup:\n    -> {line}")
            return False

    tmp_path = f"{path}.tmp.{os.getpid()}"
    try:
        with open(tmp_path, "w") as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
    except Exception as exc:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        print(f"[Gagal] Tidak dapat menyimpan file startup: {exc}")
        return False
    return True


# ---------------------------------------------------------------------------
def acquire_lock():
    """Cegah dua vpptc berjalan bersamaan (BUG MINOR: race condition)."""
    try:
        os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
        handle = open(LOCK_FILE, "w")
    except Exception as exc:
        print(f"[WARN] Gagal membuat lock file ({exc}), melanjutkan tanpa lock.")
        return None
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        die("[FATAL] Instance vpptc lain sedang berjalan. Selesai dulu atau "
            "hapus lock bila yakin tidak ada proses aktif.", code=3)
    return handle


def warn_non_default_paths(args):
    """Peringatkan bila --config/--startup-file diarahkan ke luar lokasi default.

    Alasan:vpptc memakai model full-replacement. YAML adalah SELURUH acuan,
    jadi setiap policer berawalan "vpptc-" yang tidak ada di file yang
    sedang dijalankan akan dihapus. Menjalankan vpptc dengan config yang
    lebih sempit di mesin produksi karena itu bisa mematikan shaping pada
    interface yang tidak disebut di file tersebut.

    Di produksi: jalankan `vpptc` tanpa opsi apa pun. Opsi --config dan
    --startup-file hanya untuk pengujian/staging.
    """
    if args.dry_run:
        return  # dry-run tidak mengubah apa pun, jadi tidak berisiko

    non_default = []
    if args.config != DEFAULT_CONFIG_FILE:
        non_default.append(f"--config      : {args.config}")
    if args.startup_file != DEFAULT_STARTUP_OUT_FILE:
        non_default.append(f"--startup-file: {args.startup_file}")
    if not non_default:
        return

    baris = "-" * 68
    print("\n" + baris)
    print(" PERINGATAN: MENJALANKAN DI LUAR MODE PRODUKSI")
    print(baris)
    for item in non_default:
        print(f" {item}")
    print()
    print(" vpptc memakai model full-replacement: YAML adalah SELURUH acuan.")
    print(" Setiap policer berawalan 'vpptc-' yang tidak ada di file yang")
    print(" sedang dijalankan akan DIHAPUS dari VPP - termasuk milik konfigurasi")
    print(" lain yang sebelumnya berjalan di mesin ini.")
    print()
    print(" Di produksi, jalankan tanpa opsi:")
    print(f"     vpptc")
    print(f" ...yang memakai {DEFAULT_CONFIG_FILE} dan {DEFAULT_STARTUP_OUT_FILE}.")
    print()
    print(" Jika ini memang uji coba/staging yang disengaja, abaikan peringatan ini.")
    print(baris + "\n")


def main():
    parser = argparse.ArgumentParser(description="VPP Policer YAML Synchronizer")
    parser.add_argument("--dry-run", action="store_true",
                        help="Menampilkan diff tanpa melakukan eksekusi ke VPP")
    parser.add_argument("--config", default=DEFAULT_CONFIG_FILE,
                        help="File YAML konfigurasi. HANYA untuk pengujian/staging - "
                             "di produksi selalu pakai file default.")
    parser.add_argument("--startup-file", default=DEFAULT_STARTUP_OUT_FILE,
                        help="File CLI startup yang dihasilkan. HANYA untuk "
                             "pengujian/staging - di produksi selalu pakai file default.")
    args = parser.parse_args()

    config_path = args.config

    if not os.path.exists(config_path):
        print(f"File konfigurasi tidak ditemukan: {config_path}")
        sys.exit(1)

    try:
        with open(config_path) as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as exc:
        print(f"[ERROR] Format YAML tidak valid. "
              f"Periksa spasi atau indentasi file {config_path}.")
        print(exc)
        sys.exit(1)
    except OSError as exc:
        print(f"[ERROR] Gagal membaca file konfigurasi: {exc}")
        sys.exit(1)

    if data is None:
        print(f"[ERROR] File {config_path} kosong.")
        sys.exit(1)

    validate_yaml_schema(data)

    simple_policers = data["simple_policers"]

    warn_non_default_paths(args)

    if args.dry_run:
        # M5: dry-run murni "lihat apa yang berubah" -> tidak ada file yang ditulis.
        sync_simple_policers(simple_policers, True)
        sys.exit(0)

    lock = acquire_lock()
    try:
        # H6: startup file selalu ditulis ulang, termasuk saat daftar policer kosong,
        # supaya tidak ada perintah lama yang "hidup lagi" setelah restart.
        startup_cmds, _, failures = sync_simple_policers(simple_policers, False)

        if failures:
            sys.exit(1)

        if write_startup_file(args.startup_file, startup_cmds, config_path):
            print(f"[OK] Perintah startup berhasil di-update dan disimpan ke: "
                  f"{args.startup_file}")
        else:
            sys.exit(1)
    finally:
        if lock is not None:
            lock.close()


if __name__ == "__main__":
    main()